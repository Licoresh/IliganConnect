<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-11-06T17:20:56Z" agent="Codex" version="24.7.17" type="device"><diagram id="iligan-business-data-model" name="Business Data Model"><mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ILIGAN CONNECT BUSINESS DATA MODEL" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="500" y="35" width="1200" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Logical core reporting model | PK = primary key | FK = foreign key | private access is enforced by backend permissions" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#5a6c7d;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="1600" height="32" as="geometry" /></mxCell><mxCell id="profile" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;PROFILES&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id → Auth user&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;role · account_status · display_name&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;barangay_id · notifications_enabled&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Resident, staff, or administrator account&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4f7;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="400" height="175" as="geometry" /></mxCell><mxCell id="barangay" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;BARANGAYS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · name&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;indicative boundary geometry · source_url&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Report and staff-jurisdiction reference&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4f7;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="400" height="175" as="geometry" /></mxCell><mxCell id="category" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;REPORT CATEGORIES&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · name · active&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Six configured concern categories&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Referenced by reports and access rules&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4f7;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="400" height="175" as="geometry" /></mxCell><mxCell id="organization" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;ORGANIZATIONS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · name · active · responsibility&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Potential routing destinations&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Names alone do not grant access&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4f7;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="500" height="175" as="geometry" /></mxCell><mxCell id="membership" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;ORGANIZATION MEMBERSHIPS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK/FK user_id → Profiles&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK/FK organization_id → Organizations&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Many-to-many office membership&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Membership alone grants no report scope&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="430" height="200" as="geometry" /></mxCell><mxCell id="accessrule" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;ORGANIZATION ACCESS RULES&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK organization · category&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;optional barangay · enabled&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;assignment_only · can_review&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;can_update · can_refer · notes&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="550" y="560" width="430" height="210" as="geometry" /></mxCell><mxCell id="report" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;REPORTS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK resident · category · barangay&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;optional current organization&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;title · description · status · created_at&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;latitude · longitude · source · accuracy&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Confirmed pin and barangay required for new reports&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f2ef;strokeColor=#087e8b;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="540" width="590" height="250" as="geometry" /></mxCell><mxCell id="assignment" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;REPORT ASSIGNMENTS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK report · organization&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;actor profile · reason · created_at&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Records referral/reassignment events&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Destination must match active access rules&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1690" y="560" width="430" height="210" as="geometry" /></mxCell><mxCell id="attachment" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;REPORT ATTACHMENTS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK report&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;private storage path · owner profile&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;created_at · optional evidence photo&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;File remains in private storage&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="430" height="210" as="geometry" /></mxCell><mxCell id="history" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;REPORT STATUS HISTORY&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK report · actor profile&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;old status · new status · public note&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;created_at&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Status events form resident-visible history&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="560" y="1050" width="470" height="210" as="geometry" /></mxCell><mxCell id="notifications" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;NOTIFICATIONS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · FK user · optional report&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;title · read_at · created_at&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Private in-app notification record&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Remote push is not included&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1080" y="1050" width="430" height="210" as="geometry" /></mxCell><mxCell id="audit" value="&lt;div style=&quot;font-family:Arial;font-size:16px;font-weight:bold;color:#18364e&quot;&gt;AUDIT LOGS&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;PK id · actor profile · entity · record id&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;action · old/new values · created_at&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;System-written; permitted admins may review&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:13px;color:#40556a&quot;&gt;Ordinary client access cannot edit entries&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8294a6;strokeWidth=2;arcSize=10;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="1050" width="560" height="210" as="geometry" /></mxCell><mxCell id="profile-report" value="1 resident : many reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="profile" target="report"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="barangay-report" value="1 barangay : many reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="barangay" target="report"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="category-report" value="1 category : many reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="category" target="report"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="organization-assignment" value="1 organization : many assignments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="organization" target="assignment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="report-assignment" value="1 report : many events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="report" target="assignment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="report-attachment" value="1 report : many files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="report" target="attachment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="report-history" value="1 report : many status events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="report" target="history"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="report-notifications" value="optional report link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="report" target="notifications"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="profile-membership" value="1 profile : many memberships" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="profile" target="membership"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="organization-membership" value="1 organization : many memberships" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="organization" target="membership"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="organization-access-rule" value="1 organization : many rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="organization" target="accessrule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="category-access-rule" value="1 category : many rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7890a3;strokeWidth=2;startArrow=none;endArrow=none;fontSize=12;fontColor=#52697b;" edge="1" parent="1" source="category" target="accessrule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="scope-note" value="Core reporting entities only. Optional consultations, meetings, announcements, and analytics are not shown. Historical reports may lack coordinates; all new reports require a confirmed pin and barangay." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f8;strokeColor=#d7e1e8;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#586a7c;" vertex="1" parent="1"><mxGeometry x="80" y="1370" width="2040" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>