# Resident website Vercel project only.
# These Expo public values are embedded in the browser bundle. Copy them from
# the existing Supabase project so resident and staff data remain in one system.
EXPO_PUBLIC_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-publishable-or-anon-key>

# Do not add SUPABASE_SERVICE_ROLE_KEY or other server secrets to this file or
# to either client-side Vercel project.
